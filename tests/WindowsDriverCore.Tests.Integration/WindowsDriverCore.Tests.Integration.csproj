<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Literal, not inherited: Buildalyzer reads this textually. See Directory.Build.props. -->
    <!-- 17763 because this references Platform, which needs the WinRT
         projection for InputInjector. The RUNTIME floor is unchanged and
         is declared once in Directory.Build.props. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
  </PropertyGroup>
  <!-- Drives a real application through the real driver. Targets apps we
       control and version — not Store apps, which drift underneath the suite.
       Requires a desktop session. -->
  <!-- Hosts the real server in-process for the session lifecycle test, which
       is the only integration test that goes over HTTP. Everything else here
       drives the automation layer directly, on purpose. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WindowsDriverCore.Host\WindowsDriverCore.Host.csproj" />
    <!-- Build order only. The test subject is launched as a process, so its
         assembly must not be referenced. -->
    <ProjectReference Include="..\..\apps\WindowsDriverCore.TestApp.Wpf\WindowsDriverCore.TestApp.Wpf.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\WindowsDriverCore.Platform\WindowsDriverCore.Platform.csproj" />
    <ProjectReference Include="..\..\src\WindowsDriverCore.Automation\WindowsDriverCore.Automation.csproj" />
  </ItemGroup>
</Project>
