<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Literal, not inherited: Buildalyzer reads this textually. See Directory.Build.props. -->
    <!-- 17763 because this references Platform, which needs the WinRT
         projection for InputInjector. The RUNTIME floor is unchanged and
         is declared once in Directory.Build.props. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
  </PropertyGroup>
  <!-- Drives the real HTTP surface in-memory via WebApplicationFactory and
       asserts exact JSON Wire Protocol envelopes, status codes and error
       strings. One test per row of the 60-route table. Touches no desktop, so
       it runs on any CI image in seconds. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\WindowsDriverCore.Host\WindowsDriverCore.Host.csproj" />
    <ProjectReference Include="..\..\src\WindowsDriverCore.Protocol\WindowsDriverCore.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>
  <ItemGroup>
    <!-- The recordings are the protocol contract; tests read them at runtime. -->
    <Content Include="Recordings\winappdriver-responses.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
