<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- GenerateDocumentationFile is on solution-wide so IDE0005 runs during
         build; test projects have no public API to document, so the resulting
         "missing XML comment" noise is suppressed here rather than turned off
         globally. -->
    <!-- CS1591: test projects have no public API to document, so the
         solution-wide GenerateDocumentationFile (needed for IDE0005) would
         otherwise demand XML comments on every fixture.

         CA1707: forbids underscores in member names. Test methods here are named
         {Method}_{Scenario}_{Expected} deliberately — that convention is what
         makes a failing test name state what broke without opening the file.
         Scoped to tests/ only; production naming stays under the rule.

         CA1062: demands a null guard on every parameter of an externally visible
         method. Test fixtures are public only because the runner needs to reach
         them, not because they are an API anyone calls; guarding NUnit-supplied
         TestCaseSource arguments would be noise that hides real findings. -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
</Project>
