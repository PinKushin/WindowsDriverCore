<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Runtime dependencies. -->
  <ItemGroup>
    <!-- FlaUI's interop layer, authored by Roemer. This is the raw IUIAutomation
         COM surface and the only thing this driver needs from that ecosystem:
         FlaUI.Core sits on top of exactly this, so taking the wrapper as well
         would mean wrapping a wrapper to fix the wrapper's caching bugs (#857,
         #1079) — which are the reason this project exists. -->
    <PackageVersion Include="Interop.UIAutomationClient" Version="10.19041.0" />

    <!-- Screenshot capture. Deliberately the package rather than
         <FrameworkReference Include="Microsoft.WindowsDesktop.App" />: the
         framework reference drags WPF and WinForms into a headless HTTP server
         and makes the .NET Desktop Runtime a deployment prerequisite. This
         needs only the ASP.NET Core runtime. -->
    <!-- Must stay >= 10.0.9: Appium.WebDriver 8.3.2, referenced by the benchmark
         project, requires it and NuGet reports the downgrade as an error under
         central package management. -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.10" />

    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <!-- Analyzers, applied solution-wide from Directory.Build.props. Never shipped. -->
  <ItemGroup>
    <PackageVersion Include="Roslynator.Analyzers" Version="4.16.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.31.0.145097" />
  </ItemGroup>

  <!-- Test-only dependencies.

       NUnit rather than xUnit deliberately: every Appium and WinAppDriver
       sample is written in NUnit/MSTest style, and a large part of this suite
       is the *logic* of WinAppDriver's own WebDriverAPI tests re-expressed
       against targets we control. Matching the idiom keeps that port a
       translation of intent rather than of framework. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.1.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />

    <!-- Property-based testing: generates thousands of inputs and shrinks a
         failure to its smallest reproducing case. Complements the fuzzer, which
         hunts for crashes on malformed input; these assert that a stated
         property holds across valid input.

         The obvious targets here are the round-trips: a RuntimeId that
         serializes and parses back to itself, a locator strategy that maps to
         exactly one condition, an error code that maps to exactly one HTTP
         status. Apache-2.0, test-only, never shipped. -->
    <PackageVersion Include="CsCheck" Version="4.8.0" />
  </ItemGroup>

  <!-- Fuzzing. SharpFuzz instruments a target assembly and drives it with
       libFuzzer; run on a schedule rather than per push. The natural targets
       are the untrusted-input boundaries: the JSON request bodies, the
       capability strings (an app path reaches Process.Start), and the window
       handle parser, which takes an arbitrary caller-supplied hex string.
       MIT licensed, its own non-packable project, never shipped. -->
  <ItemGroup>
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

  <!-- Benchmark-only. Never shipped: benchmarks live in their own non-packable
       project.

       FlaUI and the Appium client are referenced *only* here, so the driver
       itself never takes a dependency on either. They are the two comparison
       baselines — see docs/REWRITE-SPEC.md for why they measure different
       axes (FlaUI is in-process, WinAppDriver is over HTTP). -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="FlaUI.Core" Version="5.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageVersion Include="Appium.WebDriver" Version="8.3.2" />
  </ItemGroup>

</Project>
