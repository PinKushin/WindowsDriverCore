<Project>

  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- TargetFramework is declared in EVERY csproj, not here, and that
         duplication is deliberate.

         Buildalyzer — which Stryker.NET uses to work out what to mutate — reads
         the project file textually to find the target framework. It does not
         evaluate MSBuild first, so a TargetFramework inherited from this file is
         invisible to it, and so is `$(SomeProperty)` indirection. Both were
         measured: with the value only here, Stryker reports "No project found"
         and exits in about a second having analysed nothing.

         PokemonBattleJournal and TcgDex.CSharpSdk both have a
         Directory.Build.props and neither puts TargetFramework in it, which is
         why Stryker works in those repositories and did not work here.

         If you move it back, mutation testing stops working silently. -->

    <!-- Strict null analysis: reference types are non-nullable by default and a
         possible null is a compile error. Nullability is opt-in via `string?`. -->
    <Nullable>enable</Nullable>

    <!-- Namespaces are declared explicitly in each project's GlobalUsings.cs
         rather than injected invisibly by the SDK. -->
    <ImplicitUsings>disable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Required for IDE0005 (unused usings) to run during build, not just in
         the IDE. Test projects suppress the resulting CS1591. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- THE RUNTIME FLOOR, DECLARED ONCE FOR EVERY PROJECT.
         Separate from the TargetFramework's SDK version, which only says which
         APIs the compiler can see. 14393 is Windows 10 1607, matching
         WinAppDriver's own floor.

         It is a DECLARATION, not an enforcement. CA1416 was forced to error
         against a deliberately unguarded Windows 10 1809 call and the build
         still succeeded, because the WinRT projections carry no
         SupportedOSPlatform attributes. What actually protects a 1607 machine is
         WinRtTouchInjector.TryCreate returning null and the Win32 fallback
         behind it - and a test, not the compiler, is what shows that works. -->
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.14393.0</SupportedOSPlatformVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Every security rule, not just the recommended subset. This server binds
         a socket, launches processes from caller-supplied strings, and marshals
         raw COM pointers — the three places CA3xxx/CA5xxx findings actually
         matter. The previous implementation shipped a command-injection vector
         through Process.Start that `recommended` would not have flagged.
         Combined with TreatWarningsAsErrors, a security finding fails the build
         rather than joining a warning list nobody reads. -->
    <AnalysisModeSecurity>All</AnalysisModeSecurity>

    <!-- Fail restore on a dependency with a known advisory, transitive included. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Analyzers applied everywhere. Neither ships: both are analyzer-only
       packages with PrivateAssets=all. -->
  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
