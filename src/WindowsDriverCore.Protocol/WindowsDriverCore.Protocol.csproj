<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Literal, not inherited: Buildalyzer reads this textually. See Directory.Build.props. -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <!-- The JSON Wire Protocol surface: routes, response envelopes, error mapping.
       Owns all serialization. Contains no UIA. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Contracts ONLY. Referencing Automation or Platform from here is what made
       the whole graph Windows-bound, and the plain net10.0 target above turns a
       reintroduction into a build error rather than a surprise in CI. -->
  <ItemGroup>
    <ProjectReference Include="..\WindowsDriverCore.Contracts\WindowsDriverCore.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ProgressAt is internal and is the one pure decision in the pointer path
         worth testing on its own: how far along a move is at a given moment.
         Driving that from the frame INDEX rather than the clock made an
         identical gesture move a LoopingSelector by anywhere from 5 to 15 items
         (measured on the guest, 2026-08-30). It is internal because no caller
         outside this assembly should reach it, not because it is unimportant. -->
    <InternalsVisibleTo Include="WindowsDriverCore.Tests.Unit" />
  </ItemGroup>
  <!-- No Microsoft.Extensions.Logging.Abstractions PackageReference here:
       the ASP.NET Core framework reference above already provides it, and
       NuGet reports the redundant reference as NU1510. -->
</Project>
