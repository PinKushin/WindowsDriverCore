<Project Sdk="Microsoft.NET.Sdk">
  <!-- Win32 P/Invoke, window discovery, input synthesis, process lifetime.
       Bottom of the stack: references nothing of ours. -->
  <PropertyGroup>
    <!-- Literal, not inherited: Buildalyzer reads this textually. See Directory.Build.props. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Scoped to this project, not the solution. LibraryImport generates the
         marshalling stubs and they are unsafe by construction; this is also the
         only project that should ever need it, since it is the only one that
         touches native memory. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The integration suite is the only coverage this project has, and it
         needs to reach IsPackagedApplication, which is internal because nothing
         outside the launcher should branch on it. -->
    <InternalsVisibleTo Include="WindowsDriverCore.Tests.Integration" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
