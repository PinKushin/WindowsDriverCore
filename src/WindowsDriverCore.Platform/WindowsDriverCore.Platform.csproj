<Project Sdk="Microsoft.NET.Sdk">
  <!-- Win32 P/Invoke, window discovery, input synthesis, process lifetime.
       Bottom of the stack: references nothing of ours. -->
  <PropertyGroup>
    <!-- Literal, not inherited: Buildalyzer reads this textually. See Directory.Build.props. -->
    <!--
      THE SDK VERSION IS WHAT WE COMPILE AGAINST; SupportedOSPlatformVersion IS
      WHAT MUST RUN IT. They are deliberately different.

      17763 (Windows 10 1809) is where Windows.UI.Input.Preview.Injection.
      InputInjector appears, and that API is the whole reason this project needs
      a versioned TFM at all - see WinRtPointerInjector. Without the version
      suffix there is no WinRT projection and the type does not exist to the
      compiler.

      14393 (Windows 10 1607) is the floor this driver claims, matching
      WinAppDriver's own. Declaring it keeps that promise explicit in the build.

      DO NOT EXPECT THE COMPILER TO POLICE THE GUARD. CA1416 was forced to error
      against a deliberately unguarded InputInjector call and the build still
      succeeded - the WinRT projection does not carry the SupportedOSPlatform
      attributes the analyzer needs. The fallback is therefore verified by a
      TEST, not by the build, and that is the only thing standing between a 1607
      machine and a MissingMethodException.
    -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <!-- Scoped to this project, not the solution. LibraryImport generates the
         marshalling stubs and they are unsafe by construction; this is also the
         only project that should ever need it, since it is the only one that
         touches native memory. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The integration suite reaches IsPackagedApplication, which is internal
         because nothing outside the launcher should branch on it. -->
    <InternalsVisibleTo Include="WindowsDriverCore.Tests.Integration" />

    <!-- Not everything in here needs a desktop. SyntheticPointer.Span turns a
         centre and a size into a contact box and is pure arithmetic, so it
         belongs in the unit suite - which also means it runs on CI, where there
         is no desktop and the integration coverage skips. -->
    <InternalsVisibleTo Include="WindowsDriverCore.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WindowsDriverCore.Contracts\WindowsDriverCore.Contracts.csproj" />
  </ItemGroup>

</Project>
