<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Composition root: CLI parsing, DI wiring, the request transcript, Kestrel.

    NO LOGGING PACKAGES, deliberately. Five Serilog references sat here unused
    from the start and were removed on 2026-08-11 when diagnostics were actually
    built: the transcript is an in-box EventSource with an EventListener writing
    to a console or a file. An unused dependency is not free - it is supply-chain
    surface and an audit obligation for something nothing calls.
  -->
  <PropertyGroup>
    <!-- Literal, not inherited: Buildalyzer reads this textually. See Directory.Build.props. -->
    <!-- 17763 because this references Platform, which needs the WinRT
         projection for InputInjector. The RUNTIME floor is unchanged and
         is declared once in Directory.Build.props. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>WindowsDriverCore</AssemblyName>
    <RootNamespace>WindowsDriverCore.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WindowsDriverCore.Protocol\WindowsDriverCore.Protocol.csproj" />
    <ProjectReference Include="..\WindowsDriverCore.Automation\WindowsDriverCore.Automation.csproj" />
    <ProjectReference Include="..\WindowsDriverCore.Platform\WindowsDriverCore.Platform.csproj" />
  </ItemGroup>
</Project>
