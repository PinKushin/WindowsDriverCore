{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/Schemas/stryker-config-schema.json",
  "stryker-config": {
    "test-projects": [
      "tests/WindowsDriverCore.Tests.Unit/WindowsDriverCore.Tests.Unit.csproj",
      "tests/WindowsDriverCore.Tests.Protocol/WindowsDriverCore.Tests.Protocol.csproj"
    ],
    "target-framework": "net10.0-windows",
    "reporters": [
      "html",
      "progress",
      "cleartext"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "**/*.cs",
      "!**/GlobalUsings.cs",
      "!src/WindowsDriverCore.Platform/**/*Interop*.cs"
    ],
    "solution": "WindowsDriverCore.slnx",
    "comment": "Tests.Integration is deliberately absent. It launches Calculator and Settings, so including it would drive the real desktop once per mutant \u2014 hundreds of app launches and clicks, on a machine somebody is using. Mutation testing here runs against the headless projects only."
  }
}
