{
  "project": {
    "name": "WindowsDriverCore",
    "description": "A modern, reliable, open-source Windows automation driver built for Appium and .NET 10",
    "targetFramework": "net10.0",
    "port": 4723,
    "launchBrowser": false,
    "license": "MIT",
    "readmePath": "docs/README.md"
  },
  "coreEndpoints": [
    {
      "method": "GET",
      "path": "/status",
      "description": "Server status and readiness",
      "response": {"value": {"ready": true, "message": "Windows WebDriver replacement is running"}}
    },
    {
      "method": "POST",
      "path": "/session",
      "description": "Create new session with capabilities",
      "requestBody": {"capabilities": {"alwaysMatch": {"platformName": "Windows", "app": "Path/To/App.exe"}}},
      "response": {"value": {"sessionId": "uuid", "capabilities": {}}}
    },
    {
      "method": "DELETE",
      "path": "/session/{sessionId}",
      "description": "Terminate session",
      "response": {"value": null}
    },
    {
      "method": "POST",
      "path": "/session/{sessionId}/element",
      "description": "Create new element",
      "requestBody": {"using": "accessibility id", "value": "LoginButton"},
      "response": {"value": {"elementId": "uuid", "type": "element"}}
    },
    {
      "method": "POST",
      "path": "/session/{sessionId}/element/{elementId}/click",
      "description": "Click element",
      "response": {"value": null}
    },
    {
      "method": "POST",
      "path": "/session/{sessionId}/element/{elementId}/value",
      "description": "Send keys to element",
      "requestBody": {"text": "hello world"},
      "response": {"value": null}
    },
    {
      "method": "GET",
      "path": "/session/{sessionId}/screenshot",
      "description": "Take screenshot",
      "response": {"value": "iVBORw0KGgoAAAANSUhEUg..."}
    }
  ],
  "testIntegration": {
    "winAppDriverRoot": "../WinAppDriver",
    "testProjects": ["AbsoluteXPath", "Input", "UWPControls", "WebDriverAPI"],
    "commonSettings": "WebDriverAPI/AppSessionBase/CommonTestSettings.cs",
    "winAppDriverUrl": "http://127.0.0.1:4723",
    "testFramework": "net48",
    "testRepository": "https://github.com/microsoft/WinAppDriver"
  },
  "architecture": {
    "components": ["WebDriverServer", "CommandDispatcher", "SessionManager", "AppLauncher", "WindowFinder", "UIAutomationLayer", "ScreenshotService", "WebDriverModel"],
    "win32Apis": ["EnumWindows", "GetWindowThreadProcessId", "IsWindowVisible"],
    "uiAutomation": ["AutomationElement.FromHandle", "FindFirst", "FindAll"],
    "screenshotTechnique": "GDI BitBlt → PNG → Base64"
  },
  "dependencies": {
    "driver": ["appium-dotnet-driver", "Newtonsoft.Json"],
    "tests": {
      "selenium": "3.8.0 / 3.11.2",
      "appium-dotnet-driver": "3.0.0.2 / 4.0.0.1-beta",
      "castle": "3.3.3 / 4.2.1",
      "mstest": "1.1.14 / 1.3.2",
      "newtonsoft": "10.0.2 / 10.0.3"
    }
  },
  "nonTestAssets": {
    "docs": ["technical-design.md", "implementation-guide.md", "AI_CONTEXT.md", "ai_context.json", "README.md"],
    "ignore": [".vs/", "bin/", "obj/", "*.pdb", "*.xml"]
  }
}
